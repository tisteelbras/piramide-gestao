# Copie este arquivo para .env.local e preencha com os dados reais do Postgres.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Ex. local:   postgresql://postgres:minhasenha@localhost:5432/sos_steelbras
# Ex. empresa: postgresql://sos_user:senha@192.168.0.10:5432/sos_steelbras
DATABASE_URL=

# Segredo para assinar as sessões de login (gere um valor aleatório longo).
AUTH_SECRET=

# ————— IA do diagnóstico (OPCIONAL) —————
# Sem isto, o diagnóstico usa só as regras (funciona 100%). Com uma chave,
# a IA SOMA recomendações cruzando os 4 níveis. É plugável: troque o provedor
# sem mexer no código.
#   AI_PROVIDER: groq (padrão) | openai | ollama | custom
#   AI_API_KEY:  a chave do provedor (Groq: crie grátis em console.groq.com).
#                Ollama roda local e não precisa de chave.
#   AI_MODEL:    opcional, sobrescreve o modelo padrão do provedor.
#   AI_BASE_URL: opcional, sobrescreve o endpoint (obrigatório p/ custom).
# Ex. Groq (gratuito):  AI_PROVIDER=groq   AI_API_KEY=gsk_...
# Ex. Ollama (local):   AI_PROVIDER=ollama (sem chave; precisa do Ollama rodando)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
