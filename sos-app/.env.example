# Copie este arquivo para .env.local e preencha com os dados reais do Postgres.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Ex. local:   postgresql://postgres:minhasenha@localhost:5432/sos_steelbras
# Ex. empresa: postgresql://sos_user:senha@192.168.0.10:5432/sos_steelbras
DATABASE_URL=

# Segredo para assinar as sessões de login (gere um valor aleatório longo).
AUTH_SECRET=
